digraph G {
    rankdir=LR;
    node [shape=circle];

    0 [style=filled, fillcolor=lightgreen, label="0\n(S)"];
    1;
    2;
    3;
    4 [style=filled, fillcolor=mistyrose];
    5 [style=filled, fillcolor=mistyrose];
    6 [style=filled, fillcolor=lightblue, label="6\n(F)"];

    0 -> 1;
    1 -> 2;
    2 -> 3;
    0 -> 4 [color=red, penwidth=2.5];
    4 -> 5 [color=red, penwidth=2.5];
    5 -> 6 [color=red, penwidth=2.5];
}
