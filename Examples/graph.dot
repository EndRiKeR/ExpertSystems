digraph G {
    rankdir=LR;
    node [shape=circle];

    0 [style=filled, fillcolor=lightgreen, label="0\n(S)"];
    1 [style=filled, fillcolor=mistyrose];
    2;
    3;
    4 [style=filled, fillcolor=mistyrose];
    5 [style=filled, fillcolor=mistyrose];
    6;
    7 [style=filled, fillcolor=lightblue, label="7\n(F)"];

    0 -> 1 [color=red, penwidth=2.5];
    1 -> 4 [color=red, penwidth=2.5];
    0 -> 3;
    3 -> 4;
    7 -> 4;
    4 -> 5 [color=red, penwidth=2.5];
    3 -> 5;
    5 -> 7 [color=red, penwidth=2.5];
    0 -> 2;
    2 -> 6;
    6 -> 7;
    3 -> 6;
}
